alias download="cd ~/Downloads"
alias uuidgen='uuidgen | tr "[:upper:]" "[:lower:]"'
alias vim='nvim'
alias python="python3"
alias pip="pip3"
alias be="bundle exec"
alias perpy="pipenv run python"
alias dc="docker compose"
alias soa='source ~/.aliases; echo "Sourced aliases"'
alias clauded="claude --dangerously-skip-permissions"

# Java versions
alias java-17="export JAVA_HOME=$(/usr/libexec/java_home -v 17); java -version"
alias java-11="export JAVA_HOME=$(/usr/libexec/java_home -v 11); java -version"

gbd() {
  [[ ! -z $1 ]] && git branch -D $(git branch -l $1)
}

cpb() {
  cat "$1" | pbcopy
}

readtime() {
  total_time=$(echo "scale=2; $(pbpaste | wc -w) / 183" | bc)
  minutes=$(echo $total_time | cut -d . -f 1)
  seconds=$(printf "%.0f"  "$((.$(echo $total_time | cut -d . -f 2)*60))")
  echo "Est time: $minutes minutes and $seconds seconds"
}

alias pkey='cat ~/.ssh/id_rsa.pub | pbcopy'

[ -f "${DOTFILES_DIR:-$HOME/.dotfiles}/adsk/aliases.sh" ] && source "${DOTFILES_DIR:-$HOME/.dotfiles}/adsk/aliases.sh"
