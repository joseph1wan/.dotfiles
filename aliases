# Convert markdown in clipboard to Slack mrkdwn format
alias slackmd='pbpaste | sed -E "s/\*\*([^*]+)\*\*/\*\1\*/g; s/~~([^~]+)~~/~\1~/g; s/\[([^]]+)\]\(([^)]+)\)/<\2|\1>/g" | pbcopy'

