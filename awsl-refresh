#!/bin/bash

# Management script for awsl-refresh daemon
# Usage: awsl-refresh <command> [env]

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DAEMON_SCRIPT="$SCRIPT_DIR/awsl-refresh-daemon.sh"

# Function to find all PID files
find_pid_files() {
  ls "$HOME"/.awsl-refresh-*.pid 2>/dev/null || true
}

# Function to get environment from PID file
get_env_from_pidfile() {
  basename "$1" | sed 's/^\.awsl-refresh-\(.*\)\.pid$/\1/'
}

# Function to validate environment
validate_env() {
  case "$1" in
    dev|stg|prd)
      return 0
      ;;
    *)
      echo "Invalid environment: $1. Must be dev, stg, or prd"
      return 1
      ;;
  esac
}

# Start daemon for environment
start_daemon() {
  local env="${1:-stg}"
  
  if ! validate_env "$env"; then
    exit 1
  fi
  
  local pid_file="$HOME/.awsl-refresh-$env.pid"
  
  # Check if already running
  if [ -f "$pid_file" ]; then
    local pid=$(cat "$pid_file")
    if ps -p "$pid" > /dev/null 2>&1; then
      echo "Daemon already running for $env (PID: $pid)"
      return 1
    else
      # Stale PID file, remove it
      rm -f "$pid_file"
    fi
  fi
  
  # Start daemon in background
  nohup "$DAEMON_SCRIPT" "$env" > /dev/null 2>&1 &
  
  # Wait a moment to ensure it started
  sleep 1
  
  if [ -f "$pid_file" ]; then
    local pid=$(cat "$pid_file")
    echo "Started awsl-refresh daemon for $env (PID: $pid)"
  else
    echo "Failed to start daemon for $env"
    return 1
  fi
}

# Stop daemon for environment
stop_daemon() {
  local env="$1"
  
  if [ -z "$env" ]; then
    # Stop all environments
    local pid_files
    pid_files=$(find_pid_files)
    
    if [ -z "$pid_files" ]; then
      echo "No running daemons found"
      return 0
    fi
    
    for pid_file in $pid_files; do
      local env_name=$(get_env_from_pidfile "$pid_file")
      stop_daemon "$env_name"
    done
    return 0
  fi
  
  if ! validate_env "$env"; then
    exit 1
  fi
  
  local pid_file="$HOME/.awsl-refresh-$env.pid"
  
  if [ ! -f "$pid_file" ]; then
    echo "No daemon running for $env"
    return 1
  fi
  
  local pid=$(cat "$pid_file")
  
  if ps -p "$pid" > /dev/null 2>&1; then
    kill "$pid" 2>/dev/null || true
    # Wait a moment for graceful shutdown
    sleep 1
    
    # Force kill if still running
    if ps -p "$pid" > /dev/null 2>&1; then
      kill -9 "$pid" 2>/dev/null || true
    fi
    
    rm -f "$pid_file"
    echo "Stopped awsl-refresh daemon for $env"
  else
    echo "Daemon for $env not running (stale PID file)"
    rm -f "$pid_file"
    return 1
  fi
}

# Show status of all daemons
show_status() {
  local pid_files
  pid_files=$(find_pid_files)
  
  if [ -z "$pid_files" ]; then
    echo "No awsl-refresh daemons running"
    return 0
  fi
  
  echo "awsl-refresh daemon status:"
  echo "---------------------------"
  
  for pid_file in $pid_files; do
    local env=$(get_env_from_pidfile "$pid_file")
    local pid=$(cat "$pid_file")
    local log_file="$HOME/.awsl-refresh-$env.log"
    
    if ps -p "$pid" > /dev/null 2>&1; then
      local status="RUNNING"
      local last_refresh=""
      
      if [ -f "$log_file" ]; then
        last_refresh=$(grep "Successfully refreshed" "$log_file" | tail -1 | cut -d']' -f1 | tr -d '[' || echo "N/A")
      fi
      
      if [ -n "$last_refresh" ] && [ "$last_refresh" != "N/A" ]; then
        echo "  $env: $status (PID: $pid, Last refresh: $last_refresh)"
      else
        echo "  $env: $status (PID: $pid)"
      fi
    else
      echo "  $env: STOPPED (stale PID file)"
      rm -f "$pid_file"
    fi
  done
}

# Restart daemon
restart_daemon() {
  local env="${1:-stg}"
  
  if ! validate_env "$env"; then
    exit 1
  fi
  
  stop_daemon "$env" 2>/dev/null || true
  sleep 1
  start_daemon "$env"
}

# Tail logs for daemon(s)
tail_logs() {
  local env="$1"
  
  if [ -z "$env" ]; then
    # Tail logs for all running daemons
    local pid_files
    pid_files=$(find_pid_files)
    
    if [ -z "$pid_files" ]; then
      echo "No running daemons found"
      return 1
    fi
    
    # Use multitail if available, otherwise tail with labels
    if command -v multitail > /dev/null 2>&1; then
      local log_files=""
      for pid_file in $pid_files; do
        local env_name=$(get_env_from_pidfile "$pid_file")
        local log_file="$HOME/.awsl-refresh-$env_name.log"
        if [ -f "$log_file" ]; then
          if [ -z "$log_files" ]; then
            log_files="$log_file"
          else
            log_files="$log_files $log_file"
          fi
        fi
      done
      if [ -n "$log_files" ]; then
        multitail $log_files
      else
        echo "No log files found for running daemons"
        return 1
      fi
    else
      # Fallback: tail each log file with labels
      for pid_file in $pid_files; do
        local env_name=$(get_env_from_pidfile "$pid_file")
        local log_file="$HOME/.awsl-refresh-$env_name.log"
        if [ -f "$log_file" ]; then
          echo "=== Tailing log for $env_name ==="
          tail -f "$log_file" | sed "s/^/[$env_name] /" &
        fi
      done
      wait
    fi
  else
    # Tail log for specific environment
    if ! validate_env "$env"; then
      exit 1
    fi
    
    local log_file="$HOME/.awsl-refresh-$env.log"
    
    if [ ! -f "$log_file" ]; then
      echo "Log file not found for $env: $log_file"
      echo "Daemon may not have started yet or no logs have been written."
      return 1
    fi
    
    tail -f "$log_file"
  fi
}

# Main command dispatcher
case "${1:-}" in
  start)
    start_daemon "${2:-stg}"
    ;;
  stop)
    stop_daemon "${2:-}"
    ;;
  status)
    show_status
    ;;
  restart)
    restart_daemon "${2:-stg}"
    ;;
  logs)
    tail_logs "${2:-}"
    ;;
  *)
    echo "Usage: awsl-refresh <command> [env]"
    echo ""
    echo "Commands:"
    echo "  start [env]   Start daemon for environment (default: stg)"
    echo "  stop [env]    Stop daemon for environment (default: all)"
    echo "  status        Show status of all daemons"
    echo "  restart [env] Restart daemon for environment (default: stg)"
    echo "  logs [env]    Tail logs for daemon(s) (default: all running)"
    echo ""
    echo "Environments: dev, stg, prd"
    exit 1
    ;;
esac

